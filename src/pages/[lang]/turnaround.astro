---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LogoWall from '../../components/LogoWall.astro';
import StatStrip from '../../components/StatStrip.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';
import type { Lang } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getTranslations('turnaround', lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  noImageIndex
>
  <Hero {...t.hero} />

  <LogoWall heading={t.wall.heading} groups={t.wall.groups} spotlight />

  <StatStrip stats={t.stats.items} columns={5} />

  <!-- ================= SIGNATURE: 90-DAY ROADMAP (markup unchanged) ======= -->
  <section class="plan" id="plan">
    <div class="container">
      <header class="plan__head reveal">
        <p class="plan__eyebrow">{t.plan.eyebrow}</p>
        <h2 class="plan__title">{t.plan.title}</h2>
        <p class="plan__lede">{t.plan.lede}</p>
      </header>

      <div class="roadmap reveal" style="--reveal-delay: 80ms;" data-roadmap>
        <!-- SVG timeline: drawn line + travelling dot + milestone nodes -->
        <svg
          class="roadmap__svg"
          viewBox="0 0 1000 120"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient id="tr-line" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--primary)"></stop>
              <stop offset="100%" stop-color="var(--accent)"></stop>
            </linearGradient>
            <filter id="tr-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="b"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <!-- Rail (static faint track) -->
          <line class="roadmap__rail" x1="40" y1="60" x2="960" y2="60"></line>
          <!-- Progress line drawn via stroke-dashoffset -->
          <line
            class="roadmap__progress"
            data-progress-line
            x1="40"
            y1="60"
            x2="960"
            y2="60"></line>

          <!-- Milestone node markers on the rail -->
          <g class="roadmap__nodes">
            <circle class="roadmap__node" data-node="0" cx="40" cy="60" r="7"
            ></circle>
            <circle class="roadmap__node" data-node="1" cx="347" cy="60" r="7"
            ></circle>
            <circle class="roadmap__node" data-node="2" cx="653" cy="60" r="7"
            ></circle>
            <circle class="roadmap__node" data-node="3" cx="960" cy="60" r="7"
            ></circle>
          </g>

          <!-- Travelling glow dot -->
          <circle
            class="roadmap__runner"
            data-runner
            cx="40"
            cy="60"
            r="5"
            filter="url(#tr-glow)"></circle>
        </svg>

        <ol class="roadmap__cards">
          {
            t.plan.milestones.map((m, i) => (
              <li class="mstone" data-mstone={i}>
                <span class="mstone__tag">{m.tag}</span>
                <h3 class="mstone__title">{m.title}</h3>
                <p class="mstone__body">{m.body}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p
        class="plan__work reveal"
        style="--reveal-delay: 120ms"
        set:html={t.plan.work}
      />
    </div>
  </section>

  <section class="section" aria-labelledby="proof">
    <div class="container">
      <SectionHeader
        eyebrow={t.proof.eyebrow}
        title={t.proof.title}
        id="proof"
      />
      <ol class="proof-blocks">
        {
          t.proof.items.map((item, i) => (
            <li
              class="proof-block reveal"
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <h3 class="proof-block__title">{item.title}</h3>
              <p class="proof-block__body">{item.body}</p>
              <a class="proof-block__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="get">
    <div class="container">
      <SectionHeader eyebrow={t.get.eyebrow} title={t.get.title} id="get" />
      <div class="get-scroll">
        <table class="get">
          <thead>
            <tr>{t.get.columns.map(c => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              t.get.rows.map(row => (
                <tr class="get__row">
                  <th scope="row">{row.engagement}</th>
                  <td>{row.what}</td>
                  <td>{row.end}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  /* One of this page's counted stats ("~3 months") is longer than the short
     numeric values StatStrip was designed around, so its default
     `white-space: nowrap` lets the text spill into the next column at wide
     viewports. Let counted values wrap here, same as the plain-text ones
     already do — a page-scoped override, not a change to the component. */
  :global(.stat-strip .stat__value) {
    white-space: normal !important;
  }

  /* ===================== PLAN / ROADMAP ===================== */
  .plan {
    padding: var(--space-8) 0 var(--space-9);
  }

  .plan__head {
    max-width: 60ch;
    margin: 0 0 var(--space-8);
  }

  .plan__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-3);
  }

  .plan__title {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  .plan__lede {
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    color: color-mix(in oklab, var(--text) 76%, transparent);
    margin: 0;
  }

  .roadmap {
    position: relative;
  }

  .roadmap__svg {
    display: block;
    width: 100%;
    height: 90px;
    overflow: visible;
    margin-bottom: var(--space-3);
  }

  .roadmap__rail {
    stroke: var(--border);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .roadmap__progress {
    stroke: url(#tr-line);
    stroke-width: 3.5;
    stroke-linecap: round;
    /* pathLength normalized via JS-set dash values */
  }

  .roadmap__node {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 2.5;
    transition:
      fill 0.4s var(--ease-out),
      stroke 0.4s var(--ease-out),
      r 0.4s var(--ease-out);
  }

  .roadmap__node.is-lit {
    fill: var(--primary);
    stroke: color-mix(in oklab, var(--primary) 40%, var(--bg));
  }

  .roadmap__runner {
    fill: var(--accent);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .roadmap.is-running .roadmap__runner {
    opacity: 1;
  }

  .roadmap__cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    margin: 0;
  }

  .mstone {
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--bg);
    /* default state under NO-JS or reduced motion: fully visible */
    opacity: 1;
    transform: none;
  }

  /* JS-armed animated entrance (class added only when motion allowed) */
  .roadmap.is-armed .mstone {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out),
      border-color 0.55s var(--ease-out),
      box-shadow 0.55s var(--ease-out);
  }

  .roadmap.is-armed .mstone.is-lit {
    opacity: 1;
    transform: none;
    border-color: color-mix(in oklab, var(--primary) 45%, var(--border));
    box-shadow: var(--shadow-2);
  }

  .mstone::before {
    content: '';
    position: absolute;
    top: -1px;
    left: var(--space-5);
    right: var(--space-5);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .roadmap.is-armed .mstone.is-lit::before,
  .mstone.is-lit::before {
    transform: scaleX(1);
  }

  .mstone__tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .mstone__title {
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-2);
    line-height: 1.25;
  }

  .mstone__body {
    font-size: var(--font-size-sm);
    color: color-mix(in oklab, var(--text) 70%, transparent);
    margin: 0;
  }

  .plan__work {
    margin: var(--space-7) 0 0;
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--accent);
    background: color-mix(in oklab, var(--muted) 55%, transparent);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    color: color-mix(in oklab, var(--text) 84%, transparent);
    max-width: 68ch;
  }

  .plan__work strong {
    color: var(--text);
  }

  /* ===================== PROOF BLOCKS ===================== */
  .proof-blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .proof-blocks {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .proof-block {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }
  .proof-block__title {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-lg);
    letter-spacing: var(--tracking-display);
  }
  .proof-block__body {
    margin: 0 0 var(--space-4);
    color: oklch(from var(--text) l c h / 0.82);
  }
  .proof-block__link {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  /* ===================== WHAT YOU GET TABLE ===================== */
  .get-scroll {
    overflow-x: auto;
  }
  .get {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    text-align: left;
  }
  .get th,
  .get td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .get thead th {
    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    border-bottom-color: var(--line-strong);
  }
  .get tbody th {
    width: 14rem;
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    color: var(--text);
  }
  .get td {
    color: oklch(from var(--text) l c h / 0.82);
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 900px) {
    .roadmap__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* On tablet/phone the horizontal timeline reads awkwardly — hide the
       drawn rail and let the milestone cards carry the sequence. */
    .roadmap__svg {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .roadmap__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ===================== REDUCED MOTION ===================== */
  @media (prefers-reduced-motion: reduce) {
    /* Show the finished roadmap statically: full progress line, lit nodes,
       lit cards, no travelling dot. */
    .roadmap__progress {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }
    .roadmap__runner {
      opacity: 0 !important;
    }
    .roadmap__node {
      fill: var(--primary) !important;
      stroke: color-mix(in oklab, var(--primary) 40%, var(--bg)) !important;
    }
    .roadmap .mstone {
      opacity: 1 !important;
      transform: none !important;
    }
    .mstone::before {
      transform: scaleX(1) !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    /* ---------- Signature 90-day roadmap ---------- */
    const roadmap = document.querySelector('[data-roadmap]');

    if (roadmap) {
      const line = roadmap.querySelector('[data-progress-line]');
      const runner = roadmap.querySelector('[data-runner]');
      const nodes = Array.from(roadmap.querySelectorAll('[data-node]'));
      const cards = Array.from(roadmap.querySelectorAll('[data-mstone]'));

      // Node x-positions in the SVG viewBox (must mirror the markup).
      const NODE_X = [40, 347, 653, 960];
      const RUN_Y = 60;
      const totalLen = NODE_X[NODE_X.length - 1] - NODE_X[0];

      const lightUpAll = () => {
        nodes.forEach(n => n.classList.add('is-lit'));
        cards.forEach(c => c.classList.add('is-lit'));
      };

      if (reduce || !line) {
        // Static finished state (CSS reduced-motion rules also cover this).
        lightUpAll();
      } else {
        // Prime the progress line as an undrawn dash.
        line.style.strokeDasharray = String(totalLen);
        line.style.strokeDashoffset = String(totalLen);
        roadmap.classList.add('is-armed');

        let rafId = 0;
        let started = false;

        const play = () => {
          if (started) return;
          started = true;
          roadmap.classList.add('is-running');

          const duration = 2400; // <= keep it calm and deliberate
          const startTs = performance.now();
          // Fractions along the rail where each milestone sits.
          const nodeFrac = NODE_X.map(x => (x - NODE_X[0]) / totalLen);
          const lit = nodes.map(() => false);

          const step = now => {
            const t = Math.min((now - startTs) / duration, 1);
            // easeInOutCubic — the line accelerates then settles.
            const eased =
              t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

            // Draw the progress line.
            line.style.strokeDashoffset = String(totalLen * (1 - eased));

            // Move the glowing runner dot along the rail.
            const x = NODE_X[0] + totalLen * eased;
            runner.setAttribute('cx', x.toFixed(2));
            runner.setAttribute('cy', String(RUN_Y));

            // Light each node + card as the dot reaches it (natural stagger).
            nodeFrac.forEach((f, i) => {
              if (!lit[i] && eased >= f - 0.001) {
                lit[i] = true;
                if (nodes[i]) nodes[i].classList.add('is-lit');
                if (cards[i]) cards[i].classList.add('is-lit');
              }
            });

            if (t < 1) {
              rafId = requestAnimationFrame(step);
            } else {
              // Ensure everything is settled and the runner rests on the end.
              line.style.strokeDashoffset = '0';
              lightUpAll();
              runner.setAttribute('cx', String(NODE_X[NODE_X.length - 1]));
              cancelAnimationFrame(rafId);
            }
          };
          rafId = requestAnimationFrame(step);
        };

        const stop = () => {
          if (rafId) cancelAnimationFrame(rafId);
        };

        // Play on load, but only once it's actually in view (and pause the
        // rAF loop if the tab/section is scrolled away before it starts).
        if ('IntersectionObserver' in window) {
          const rObs = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  play();
                  obs.disconnect();
                } else if (!started) {
                  stop();
                }
              });
            },
            { threshold: 0.35 },
          );
          rObs.observe(roadmap);
        } else {
          play();
        }

        // Safety: if the tab is hidden mid-run, cancel; resume by replaying
        // to the finished state when it returns (no partial flicker).
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            stop();
          } else if (started) {
            line.style.strokeDashoffset = '0';
            lightUpAll();
          }
        });
      }
    }
  })();
</script>
