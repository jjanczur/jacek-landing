---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LogoWall from '../../components/LogoWall.astro';
import StatStrip from '../../components/StatStrip.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CaseRow from '../../components/CaseRow.astro';
import DoorPair from '../../components/DoorPair.astro';
import CtaBand from '../../components/CtaBand.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const t = await getTranslations('builder', lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  noImageIndex
>
  <Hero {...t.hero}>
    <div slot="aside">
      <!-- Signature animation: self-drawing architecture diagram (GR-4) -->
      <ArchDiagram
        title={t.diagram.title}
        ariaLabel={t.diagram.svgAriaLabel}
        health={t.diagram.health}
        nodes={t.diagram.nodes}
        edges={t.diagram.edges}
        meter={{
          value: t.diagram.throughputValue,
          label: t.diagram.throughputLabel,
          countTo: 3200,
        }}
      />
    </div>
  </Hero>

  <LogoWall heading={t.wall.heading} groups={t.wall.groups} spotlight />

  <StatStrip stats={t.stats.items} columns={5} />

  <section
    class="detail section section--divided section--loose"
    id="architecture"
  >
    <div class="container detail__grid">
      {
        t.details.items.map((d, i) => (
          <article
            class="detail__col reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="detail__num">{d.num}</span>
            <h2>{d.heading}</h2>
            <p>{d.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="section section--divided section--loose"
    aria-labelledby="evaluation"
  >
    <div class="container">
      <SectionHeader
        eyebrow={t.evaluation.eyebrow}
        title={t.evaluation.title}
        lede={t.evaluation.lede}
        id="evaluation"
      />
      <ol class="eval-grid">
        {
          t.evaluation.items.map((item, i) => (
            <li class="eval-item reveal" style={`--reveal-delay: ${i * 40}ms`}>
              <h3 class="eval-item__title">{item.title}</h3>
              <p class="eval-item__body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="section section--divided section--loose"
    aria-labelledby="proof-rows"
  >
    <div class="container">
      <SectionHeader
        eyebrow={t.cases.eyebrow}
        title={t.cases.title}
        id="proof-rows"
      />
      <ol class="case-rows">
        {t.cases.items.map((c, i) => <CaseRow {...c} index={i} />)}
      </ol>
    </div>
  </section>

  <DoorPair doors={t.doors} />

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  /* ---------- Detail columns ---------- */
  .detail__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-6);
  }
  .detail__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .detail__col h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    margin: var(--space-2) 0 var(--space-3);
    letter-spacing: -0.01em;
  }
  .detail__col p {
    margin: 0;
    opacity: 0.85;
  }

  /* ---------- Evaluation grid ---------- */
  .eval-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: eval;
  }
  @media (min-width: 800px) {
    .eval-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .eval-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .eval-item {
    counter-increment: eval;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }
  .eval-item__title {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-lg);
    letter-spacing: var(--tracking-display);
  }
  .eval-item__title::before {
    content: counter(eval, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .eval-item__body {
    margin: 0;
    color: oklch(from var(--text) l c h / 0.82);
  }

  .case-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
