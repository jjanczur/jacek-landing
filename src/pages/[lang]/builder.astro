---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSupportedLangs } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const logos = [
  { src: '/logos/bosch.svg', alt: 'Bosch' },
  { src: '/logos/redbull.svg', alt: 'Red Bull' },
  { src: '/logos/kfw.png', alt: 'KfW' },
  { src: '/logos/boehringer-ingelheim.png', alt: 'Boehringer Ingelheim' },
  { src: '/logos/ing.svg', alt: 'ING' },
  { src: '/logos/apg.png', alt: 'APG' },
  { src: '/logos/norges-bank.svg', alt: 'Norges Bank' },
];

const copy = {
  en: {
    metaTitle: 'Jacek Janczura — AI Systems Architect & Fractional CTO',
    metaDescription:
      "I've shipped the multi-tenant RAG system you're trying to build. Event-driven AWS, 1,000+ concurrent connections, thousands of requests a second, 99.9% uptime, for 50+ regulated organizations.",
    eyebrow: 'AI Systems Architect · Fractional CTO',
    heroTitle:
      'I\'ve shipped the AI system<br class="br-desktop" /> you\'re trying to build.',
    heroSub:
      'Multi-tenant RAG on event-driven AWS — 1,000+ concurrent connections, thousands of requests a second, 99.9% uptime, for 50+ regulated organizations. I design the architecture, build the pipelines and evals, wire the audit trails, and lead the engineers who own it. <strong>Not another proof-of-concept.</strong>',
    ctaPrimary: 'Walk through the architecture',
    ctaGhost: "Send me your pipeline; I'll tell you where it breaks",
    availability: 'Currently consulting · open to the right permanent CTO role',
    diagramTitle: 'Live system',
    diagramHealth: '99.9% uptime',
    throughputLabel: 'live throughput',
    svgAriaLabel:
      'Architecture diagram: Client to API Gateway to Lambda and Fargate to RAG Service to Vector and Graph databases and LLM providers OpenAI, Bedrock, Azure and Mistral.',
    proofKicker: 'Systems shipped for',
