---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { getTranslations, getSupportedLangs } from '../../utils/i18n';
import type { Lang } from '../../utils/i18n';

export async function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

// Mirror of ContactPanel's field props (declared locally so the page does not
// import types across .astro module boundaries).
interface ContactField {
  name: string;
  label: string;
  type: 'text' | 'email' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  rows?: number;
  options?: string[];
  autocomplete?: string;
}

interface ContactPath {
  eyebrow: string;
  title: string;
  lede: string;
  points: string[];
  cta?: { href: string; label: string; external?: boolean };
  form: {
    title: string;
    submit: string;
    note: string;
    subject: string;
    fields: ContactField[];
  };
  switchTo: { href: string; label: string };
}

interface ContactTranslations {
  meta: { title: string; description: string };
  hero: {
    eyebrow: string;
    title: string;
    sub: string;
    primary: { href: string; label: string };
    ghost: { href: string; label: string };
    availability: string;
  };
  quick: {
    title: string;
    body: string;
    calendly: string;
    linkedin: string;
    github: string;
  };
  hiring: ContactPath;
  project: ContactPath;
  privacyNote: string;
}

const { lang } = Astro.props;
const t = await getTranslations<ContactTranslations>('contact', lang);

const FORMSPREE_ACTION = 'https://formspree.io/f/myzngpqa';
const CALENDLY_URL =
  'https://calendly.com/jacek-janczura/30min?hide_event_type_details=0&hide_gdpr_banner=1';
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Hero {...t.hero} />

  <section class="contact-quick">
    <div class="container contact-quick__inner reveal">
      <div>
        <h2 class="contact-quick__title">{t.quick.title}</h2>
        <p class="contact-quick__body">{t.quick.body}</p>
      </div>
      <div class="contact-quick__actions">
        <Button href={CALENDLY_URL} variant="primary" external
          >{t.quick.calendly}</Button
        >
        <a
          class="contact-quick__link"
          href="https://linkedin.com/in/jacekjanczura"
          target="_blank"
          rel="noopener noreferrer">{t.quick.linkedin}</a
        >
        <a
          class="contact-quick__link"
          href="https://github.com/jjanczur"
          target="_blank"
          rel="noopener noreferrer">{t.quick.github}</a
        >
      </div>
    </div>
  </section>

  <div class="section contact-paths">
    <div class="container contact-paths__inner">
      <ContactPanel
        id="hiring"
        eyebrow={t.hiring.eyebrow}
        title={t.hiring.title}
        lede={t.hiring.lede}
        points={t.hiring.points}
        cta={t.hiring.cta}
        action={FORMSPREE_ACTION}
        path="hiring"
        subject={t.hiring.form.subject}
        formTitle={t.hiring.form.title}
        submit={t.hiring.form.submit}
        note={t.hiring.form.note}
        fields={t.hiring.form.fields}
        switchTo={t.hiring.switchTo}
      />
      <ContactPanel
        id="project"
        eyebrow={t.project.eyebrow}
        title={t.project.title}
        lede={t.project.lede}
        points={t.project.points}
        action={FORMSPREE_ACTION}
        path="project"
        subject={t.project.form.subject}
        formTitle={t.project.form.title}
        submit={t.project.form.submit}
        note={t.project.form.note}
        fields={t.project.form.fields}
        switchTo={t.project.switchTo}
      />
      <p class="contact-paths__privacy reveal" set:html={t.privacyNote} />
    </div>
  </div>
</BaseLayout>

<style>
  .contact-quick__inner {
    display: grid;
    gap: var(--space-5);
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }
  @media (min-width: 800px) {
    .contact-quick__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-6);
    }
  }
  .contact-quick__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-2);
  }
  .contact-quick__body {
    margin: 0;
    max-width: 52ch;
    color: oklch(from var(--text) l c h / 0.78);
  }
  .contact-quick__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .contact-quick__link {
    font-size: var(--font-size-sm);
  }

  .contact-paths__inner {
    display: grid;
    gap: var(--space-6);
  }
  .contact-paths__privacy {
    margin: 0;
    max-width: var(--w-prose);
    font-size: var(--font-size-sm);
    color: oklch(from var(--text) l c h / 0.66);
  }
</style>
