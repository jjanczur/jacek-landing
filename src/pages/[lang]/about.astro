---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import StepList from '../../components/StepList.astro';
import Timeline from '../../components/Timeline.astro';
import CredentialList from '../../components/CredentialList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getTranslations, getSupportedLangs } from '../../utils/i18n';
import type { Lang } from '../../utils/i18n';
import headshotImage from '../../assets/images/headshot.jpg';

export async function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

interface LabelledItem {
  title: string;
  body: string;
}

// Mirrors of the two components' item props (declared locally so the page does
// not import types across .astro module boundaries).
interface TimelineItem {
  period: string;
  title: string;
  org: string;
  outcome: string;
  contribution: string;
  href?: string;
}

interface CredentialGroup {
  title: string;
  items: { title: string; meta?: string; note?: string }[];
}

interface AboutTranslations {
  meta: { title: string; description: string };
  hero: {
    eyebrow: string;
    title: string;
    sub: string;
    primary: { href: string; label: string };
    ghost: { href: string; label: string; external?: boolean };
    availability: string;
  };
  narrative: {
    eyebrow: string;
    title: string;
    portraitAlt: string;
    paragraphs: string[];
  };
  operate: { eyebrow: string; title: string; steps: LabelledItem[] };
  scope: {
    eyebrow: string;
    title: string;
    lede: string;
    items: LabelledItem[];
  };
  depth: { eyebrow: string; title: string; items: LabelledItem[] };
  timeline: {
    eyebrow: string;
    title: string;
    lede: string;
    items: TimelineItem[];
  };
  credentials: {
    eyebrow: string;
    title: string;
    groups: CredentialGroup[];
    links: { href: string; label: string }[];
  };
  outside: { eyebrow: string; title: string; paragraphs: string[] };
  band: {
    title: string;
    sub: string;
    primary: { href: string; label: string };
    secondary: { href: string; label: string };
    note: string;
  };
}

const { lang } = Astro.props;
const t = await getTranslations<AboutTranslations>('about', lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Hero {...t.hero} />

  <section class="section about-narrative">
    <div class="container about-narrative__inner">
      <div class="about-portrait reveal">
        <Picture
          src={headshotImage}
          alt={t.narrative.portraitAlt}
          class="about-portrait__img"
          widths={[240, 360, 480]}
          sizes="(max-width: 900px) 200px, 320px"
          formats={['avif', 'webp']}
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="about-narrative__body">
        <SectionHeader
          eyebrow={t.narrative.eyebrow}
          title={t.narrative.title}
        />
        {
          t.narrative.paragraphs.map((paragraph, i) => (
            <p
              class="about-narrative__p reveal"
              style={`--reveal-delay: ${(i + 1) * 60}ms`}
              set:html={paragraph}
            />
          ))
        }
      </div>
    </div>
  </section>

  <StepList
    eyebrow={t.operate.eyebrow}
    title={t.operate.title}
    steps={t.operate.steps}
  />

  <section class="section about-scope">
    <div class="container">
      <SectionHeader
        eyebrow={t.scope.eyebrow}
        title={t.scope.title}
        lede={t.scope.lede}
      />
      <ul class="about-scope__list" role="list">
        {
          t.scope.items.map((item, i) => (
            <li
              class="about-scope__item reveal"
              style={`--reveal-delay: ${i * 40}ms`}
            >
              <h3 class="about-scope__title">{item.title}</h3>
              <p class="about-scope__body">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-depth">
    <div class="container">
      <SectionHeader eyebrow={t.depth.eyebrow} title={t.depth.title} />
      <ul class="about-depth__list" role="list">
        {
          t.depth.items.map((item, i) => (
            <li
              class="about-depth__item reveal"
              style={`--reveal-delay: ${i * 40}ms`}
            >
              <h3 class="about-depth__title">{item.title}</h3>
              <p class="about-depth__body">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-timeline">
    <div class="container">
      <SectionHeader
        eyebrow={t.timeline.eyebrow}
        title={t.timeline.title}
        lede={t.timeline.lede}
      />
      <Timeline items={t.timeline.items} />
    </div>
  </section>

  <section class="section about-credentials">
    <div class="container">
      <SectionHeader
        eyebrow={t.credentials.eyebrow}
        title={t.credentials.title}
      />
      <CredentialList groups={t.credentials.groups} />
      <p class="about-credentials__links reveal">
        {
          t.credentials.links.map(link => (
            <a class="about-credentials__link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </p>
    </div>
  </section>

  <section class="section about-outside">
    <div class="container">
      <SectionHeader eyebrow={t.outside.eyebrow} title={t.outside.title} />
      {
        t.outside.paragraphs.map((paragraph, i) => (
          <p
            class="about-outside__p reveal"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  .about-narrative__inner {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 900px) {
    .about-narrative__inner {
      grid-template-columns: 320px 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
  .about-portrait__img {
    width: 100%;
    max-width: 320px;
    height: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    display: block;
  }
  .about-narrative__body {
    max-width: var(--w-prose);
  }
  .about-narrative__p {
    font-size: var(--font-size-lg);
    color: oklch(from var(--text) l c h / 0.84);
  }

  .about-scope__list,
  .about-depth__list {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .about-scope__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  .about-scope__item,
  .about-depth__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .about-scope__title,
  .about-depth__title {
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-2);
  }
  .about-scope__body,
  .about-depth__body {
    margin: 0;
    max-width: var(--w-prose);
    color: oklch(from var(--text) l c h / 0.78);
  }
  .about-depth__item {
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: var(--space-5);
  }

  .about-credentials__links {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: var(--font-size-sm);
  }
  .about-outside__p {
    max-width: var(--w-prose);
    color: oklch(from var(--text) l c h / 0.82);
  }
</style>
