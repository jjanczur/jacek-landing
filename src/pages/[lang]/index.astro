    fitCtaGhost: 'Zobacz, co wdrożyłem',
    fitNote: 'Obecnie konsultuję · otwarty na właściwą stałą rolę CTO',
    wall: [
      { note: 'Bank centralny Norwegii' },
      { note: '€500B+ AUM · fundusz emerytalny' },
      { note: 'Top-20 pharma · R&D' },
      { note: 'Bank rozwoju' },
      { note: 'Certyfikowany dostawca AI' },
