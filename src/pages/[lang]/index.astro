const t = copy[lang];

const calendlyUrl =
  'https://calendly.com/jacek-janczura/30min?hide_event_type_details=0&hide_gdpr_banner=1';

// Wall of proof — named institutions. Order tuned so the wall reads as a
// coherent block: central bank + pension + pharma anchor the top row.
// Non-text fields (name, src) are IDENTICAL across languages; only `note`
// is translated (merged from `t.wall`).
const wallBase = [
  { name: 'Norges Bank', src: '/logos/norges-bank.svg' },
  { name: 'APG', src: '/logos/apg.png' },
  { name: 'Boehringer Ingelheim', src: '/logos/boehringer-ingelheim.png' },
  { name: 'KfW', src: '/logos/kfw.png' },
  { name: 'Bosch', src: '/logos/bosch.svg' },
  { name: 'Red Bull', src: '/logos/redbull.svg' },
  { name: 'ING', src: '/logos/ing.svg' },
  { name: 'Deutsche Telekom', src: '/logos/telekom.svg' },
  { name: 'idealo', src: '/logos/idealo.png' },
  { name: 'Stellantis', src: '/logos/stellantis.png' },
  { name: 'SAS', src: '/logos/sas.svg' },
  { name: 'TÜV Nord', src: '/logos/tuv-nord.png' },
];
const wall = wallBase.map((org, i) => ({ ...org, note: t.wall[i].note }));

// Count-up stats. `to` is numeric target; prefix/suffix render around it.
// Non-text fields (to, prefix, suffix, decimals, display, staticOnly) are
// IDENTICAL across languages; only `label` is translated (merged from t.stats).
const statsBase = [
  {
    to: 1,
    prefix: '€',
    suffix: 'M+',
    decimals: 0,
  },
  {
    to: 50,
    prefix: '',
    suffix: '+',
    decimals: 0,
  },
  {
    to: 1.4,
    prefix: '',
    suffix: 'M',
    decimals: 1,
  },
  {
    to: 1000,
    prefix: '',
    suffix: 's / sec',
    decimals: 0,
  },
  {
    to: 2,
    prefix: '',
    suffix: '',
    decimals: 0,
    display: 'ISO 27001 + SOC 2',
    staticOnly: true,
  },
];
const stats = statsBase.map((s, i) => ({ ...s, label: t.stats[i].label }));
---

<BaseLayout title={t.metaTitle} description={t.metaDescription} lang={lang}>
  <section class="proof-hero">
    <!-- Ambient wash sits behind everything; purely decorative -->
    <div class="hero-wash" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="eyebrow reveal">{t.eyebrow}</p>

      <h1 class="hero-title reveal" set:html={t.heroTitle} />

      <p class="tier-line reveal">
        {t.tierLine}
      </p>

      <p class="subhead reveal">
        {t.subhead}
      </p>

      <div class="cta-row reveal">
        <a class="btn btn-primary" href="#wall">{t.ctaPrimary}</a>
        <a
          class="btn btn-ghost"
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer">{t.ctaGhost}</a
        >
      </div>

      <p class="status-pill reveal" aria-label={t.availabilityAria}>
        <span class="status-dot" aria-hidden="true"></span>
        {t.availability}
      </p>
    </div>
  </section>

  <!-- WALL OF PROOF — the signature moment -->
  <section id="wall" class="wall-section" aria-labelledby="wall-heading">
    <div class="container">
      <div class="wall-head reveal">
        <h2 id="wall-heading" class="wall-heading">
          {t.wallHeading}
        </h2>
        <p class="wall-sub">
          {t.wallSub}
        </p>
      </div>

      <!-- The spotlight sweep is drawn on this layer; it never blocks clicks -->
      <div class="wall" data-wall>
        <div class="wall-spotlight" aria-hidden="true"></div>
        <ul class="wall-grid" role="list">
          {
            wall.map((org, i) => (
              <li class="chip-cell" data-chip style={`--i:${i}`}>
                <span class="chip">
                  <img
                    class="chip-logo"
                    src={org.src}
                    alt={org.name}
                    width="140"
                    height="52"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="chip-note">{org.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Count-up numbers -->
  <section class="stats-section" aria-labelledby="stats-heading">
    <div class="container">
      <h2 id="stats-heading" class="visually-hidden">{t.statsHeading}</h2>
      <div class="stats-grid" data-stats>
        {
          stats.map(s => (
            <div class="stat reveal">
              <div
                class="stat-value"
                data-count
                data-to={s.to}
                data-decimals={s.decimals}
                data-prefix={s.prefix}
                data-suffix={s.suffix}
                data-static={s.staticOnly ? s.display : ''}
              >
                {s.staticOnly
                  ? s.display
                  : `${s.prefix}${s.to.toFixed(s.decimals)}${s.suffix}`}
              </div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What I actually do with that standard -->
  <section class="method-section" aria-labelledby="method-heading">
    <div class="container">
      <h2 id="method-heading" class="method-heading reveal">
        {t.methodHeading}
      </h2>
      <div class="method-grid">
        <article class="method-card reveal">
          <span class="method-index" aria-hidden="true">01</span>
          <h3>{t.methodCards[0].title}</h3>
          <p>
            {t.methodCards[0].body}
          </p>
        </article>
        <article class="method-card reveal">
          <span class="method-index" aria-hidden="true">02</span>
          <h3>{t.methodCards[1].title}</h3>
          <p>
            {t.methodCards[1].body}
          </p>
        </article>
        <article class="method-card reveal">
          <span class="method-index" aria-hidden="true">03</span>
          <h3>{t.methodCards[2].title}</h3>
          <p>
            {t.methodCards[2].body}
          </p>
        </article>
        <article class="method-card reveal">
          <span class="method-index" aria-hidden="true">04</span>
          <h3>{t.methodCards[3].title}</h3>
          <p>
            {t.methodCards[3].body}
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Fit-call CTA -->
  <section id="fit-call" class="fit-section">
    <div class="container">
      <div class="fit-card reveal">
        <h2 class="fit-heading">{t.fitHeading}</h2>
        <p class="fit-sub">
          {t.fitSub}
        </p>
        <div class="cta-row cta-row-center">
          <a
            class="btn btn-primary"
            href={calendlyUrl}
            target="_blank"
            rel="noopener noreferrer">{t.fitCtaPrimary}</a
          >
          <a class="btn btn-ghost" href="#wall">{t.fitCtaGhost}</a>
        </div>
        <p class="fit-note">
          <span class="status-dot" aria-hidden="true"></span>
          {t.fitNote}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ *
   * HERO                                                                *
   * ------------------------------------------------------------------ */
  .proof-hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-9) 0 var(--space-8);
    isolation: isolate;
  }

  /* Soft two-tone ambient wash — decorative, no motion */
  .hero-wash {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 130%;
    z-index: -1;
    background:
      radial-gradient(
        60% 55% at 18% 12%,
        color-mix(in oklab, var(--primary) 22%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        55% 50% at 88% 8%,
        color-mix(in oklab, var(--accent) 26%, transparent) 0%,
        transparent 62%
      );
    pointer-events: none;
  }

  .hero-inner {
    max-width: 940px;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    color: var(--primary);
    margin: 0 0 var(--space-4);
  }

  .hero-title {
    font-size: clamp(2rem, 6.2vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero-title-em {
    display: block;
    background: linear-gradient(100deg, var(--primary) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tier-line {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(0.85rem, 2.2vw, 1rem);
    color: var(--text);
    opacity: 0.72;
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }

  .subhead {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--text);
    opacity: 0.9;
    max-width: 62ch;
    margin: 0 0 var(--space-6);
  }

  /* ------------------------------------------------------------------ *
   * BUTTONS                                                             *
   * ------------------------------------------------------------------ */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .cta-row-center {
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .btn {
    --btn-bg: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-m);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-base);
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out),
      background-color 0.22s var(--ease-out),
      border-color 0.22s var(--ease-out);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background: var(--primary);
    color: #fff;
    box-shadow: var(--shadow-2);
  }
  .btn-ghost {
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    color: var(--text);
    border-color: var(--border);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-3);
    }
    .btn-ghost:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
      box-shadow: var(--shadow-1);
    }
  }

  /* ------------------------------------------------------------------ *
   * STATUS PILL (currently consulting · open to permanent CTO)         *
   * ------------------------------------------------------------------ */
  .status-pill,
  .fit-note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--text);
    opacity: 0.85;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 60%, transparent);
    margin: 0;
  }
  .fit-note {
    margin-top: var(--space-5);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    flex: none;
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 7px color-mix(in oklab, var(--accent) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 0%, transparent);
    }
  }

  /* ------------------------------------------------------------------ *
   * WALL OF PROOF                                                       *
   * ------------------------------------------------------------------ */
  .wall-section {
    padding: var(--space-8) 0 var(--space-9);
  }

  .wall-head {
    max-width: 60ch;
    margin: 0 auto var(--space-7);
    text-align: center;
  }
  .wall-heading {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .wall-sub {
    color: var(--text);
    opacity: 0.72;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    margin: 0;
  }

  .wall {
    position: relative;
    border-radius: var(--radius-l);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--muted) 70%, transparent),
      color-mix(in oklab, var(--muted) 30%, transparent)
    );
    border: 1px solid var(--border);
    overflow: hidden;
    isolation: isolate;
  }

  /* The moving spotlight — a soft radial highlight positioned by JS via
     --mx/--my (percent). Sits above the tile background, below the chips'
     brightening, and never intercepts pointer events. */
  .wall-spotlight {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      34% 46% at var(--mx, 50%) var(--my, 50%),
      color-mix(in oklab, var(--primary) 26%, transparent) 0%,
      color-mix(in oklab, var(--accent) 14%, transparent) 40%,
      transparent 72%
    );
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .wall.is-lit .wall-spotlight {
    opacity: 1;
  }

  .wall-grid {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(var(--space-3), 2vw, var(--space-4));
  }

  .chip-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .chip {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: var(--radius-l);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-1);
    border: 1px solid rgba(0, 0, 0, 0.05);
    /* Brighten as the spotlight passes: driven by --lit (0..1) from JS */
    filter: brightness(calc(1 + var(--lit, 0) * 0.06));
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      filter 0.3s var(--ease-out);
    will-change: transform, filter;
  }

  .chip-logo {
    max-width: 100%;
    width: auto;
    height: clamp(30px, 5vw, 46px);
    object-fit: contain;
    display: block;
  }

  .chip-note {
    font-size: var(--font-size-xs);
    color: var(--text);
    opacity: 0.6;
    text-align: center;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  /* Staggered entrance: cells start collapsed, JS adds .is-in per-cell with a
     per-index delay via --i. Fallback keeps them visible (see reduced-motion
     + the no-anim default below). */
  .chip-cell {
    opacity: 1;
  }
  .js-anim .chip-cell {
    opacity: 0;
    transform: translateY(16px) scale(0.94);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms);
  }
  .js-anim .chip-cell.is-in {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip-cell:hover .chip {
      transform: translateY(-3px);
      box-shadow: var(--shadow-3);
    }
  }

  /* ------------------------------------------------------------------ *
   * STATS                                                              *
   * ------------------------------------------------------------------ */
  .stats-section {
    padding: 0 0 var(--space-9);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: clamp(var(--space-4), 3vw, var(--space-6));
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
  }
  .stat {
    min-width: 0;
    text-align: left;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.9rem, 5.5vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-3);
    word-break: break-word;
  }
  .stat-label {
    font-size: var(--font-size-sm);
    color: var(--text);
    opacity: 0.75;
    line-height: 1.5;
  }

  /* ------------------------------------------------------------------ *
   * METHOD                                                             *
   * ------------------------------------------------------------------ */
  .method-section {
    padding: var(--space-8) 0 var(--space-9);
    background: color-mix(in oklab, var(--muted) 45%, transparent);
  }
  .method-heading {
    text-align: center;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    letter-spacing: -0.01em;
    margin: 0 auto var(--space-7);
    max-width: 24ch;
    text-wrap: balance;
  }
  .method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(var(--space-4), 2.5vw, var(--space-5));
  }
  .method-card {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    padding: var(--space-6) var(--space-5) var(--space-5);
    min-width: 0;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  .method-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .method-index {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--primary);
    letter-spacing: 0.08em;
  }
  .method-card h3 {
    font-size: var(--font-size-lg);
    margin: var(--space-2) 0 var(--space-3);
    letter-spacing: -0.01em;
  }
  .method-card p {
    font-size: var(--font-size-sm);
    color: var(--text);
    opacity: 0.82;
    line-height: 1.6;
    margin: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .method-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-3);
      border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
    }
    .method-card:hover::before {
      transform: scaleX(1);
    }
  }

  /* ------------------------------------------------------------------ *
   * FIT CALL                                                           *
   * ------------------------------------------------------------------ */
  .fit-section {
    padding: var(--space-9) 0 var(--space-10);
  }
  .fit-card {
    position: relative;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(var(--space-6), 6vw, var(--space-9)) var(--space-5);
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background:
      radial-gradient(
        70% 120% at 50% 0%,
        color-mix(in oklab, var(--primary) 12%, transparent),
        transparent 70%
      ),
      var(--bg);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .fit-heading {
    font-size: clamp(1.6rem, 4.5vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .fit-sub {
    color: var(--text);
    opacity: 0.8;
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    max-width: 52ch;
    margin: 0 auto var(--space-6);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ------------------------------------------------------------------ *
   * REDUCED MOTION — every animation gets a visible static fallback    *
   * ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
    /* Wall + chips fully visible, no sweep. */
    .js-anim .chip-cell {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .wall.is-lit .wall-spotlight {
      opacity: 0 !important;
    }
    .chip {
      filter: none !important;
    }
    .btn,
    .method-card,
    .method-card::before {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    /* ---------------------------------------------------------------- *
     * 1. STAGGERED CHIP ENTRANCE                                        *
     * The wall only opts into the hidden start-state when JS runs AND   *
     * motion is allowed, so no-JS / reduced-motion keeps chips visible. *
     * ---------------------------------------------------------------- */
    const wall = document.querySelector('[data-wall]');
    if (wall && !reduced) {
      const grid = wall.querySelector('.wall-grid');
      if (grid) {
        grid.classList.add('js-anim');
        const cells = wall.querySelectorAll('[data-chip]');
        const revealChips = function () {
          cells.forEach(function (cell) {
            cell.classList.add('is-in');
          });
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  revealChips();
                  obs.disconnect();
                }
              });
            },
            { threshold: 0.2 },
          );
          io.observe(wall);
        } else {
          revealChips();
        }
      }
    }

    /* ---------------------------------------------------------------- *
     * 2. SPOTLIGHT SWEEP                                                *
     * A soft radial highlight glides across the wall on a slow looping  *
     * path (Lissajous-style so it never feels linear). rAF-driven,      *
     * paused when the wall is off-screen, and never started under       *
     * reduced motion. Each chip brightens by proximity to the light.    *
     * ---------------------------------------------------------------- */
    const spotlight = wall ? wall.querySelector('.wall-spotlight') : null;
    const chips = wall ? wall.querySelectorAll('.chip') : null;

    if (wall && spotlight && chips && chips.length && !reduced) {
      let rafId = null;
      let start = null;
      let onScreen = false;
      let chipBoxes = [];
      let wallBox = null;

      const measure = function () {
        wallBox = wall.getBoundingClientRect();
        chipBoxes = [];
        chips.forEach(function (chip) {
          const r = chip.getBoundingClientRect();
          chipBoxes.push({
            el: chip,
            cx: r.left + r.width / 2 - wallBox.left,
            cy: r.top + r.height / 2 - wallBox.top,
          });
        });
      };

      const frame = function (t) {
        if (start === null) start = t;
        if (!wallBox || wallBox.width === 0) {
          rafId = window.requestAnimationFrame(frame);
          return;
        }
        const elapsed = (t - start) / 1000;
        // Two out-of-phase sines => a smooth wandering path, ~11s period.
        const px = 50 + 42 * Math.sin(elapsed * 0.57);
        const py = 50 + 30 * Math.sin(elapsed * 0.83 + 1.1);
        spotlight.style.setProperty('--mx', px.toFixed(2) + '%');
        spotlight.style.setProperty('--my', py.toFixed(2) + '%');

        // Light position in px within the wall.
        const lx = (px / 100) * wallBox.width;
        const ly = (py / 100) * wallBox.height;
        const radius = Math.max(wallBox.width, wallBox.height) * 0.34;

        for (let k = 0; k < chipBoxes.length; k++) {
          const c = chipBoxes[k];
          const dx = c.cx - lx;
          const dy = c.cy - ly;
          const dist = Math.sqrt(dx * dx + dy * dy);
          // 1 at the centre of the light, easing to 0 at the radius edge.
          let lit = 1 - dist / radius;
          if (lit < 0) lit = 0;
          c.el.style.setProperty('--lit', (lit * lit).toFixed(3));
        }
        rafId = window.requestAnimationFrame(frame);
      };

      const play = function () {
        if (rafId === null) {
          measure();
          start = null;
          rafId = window.requestAnimationFrame(frame);
        }
      };
      const pause = function () {
        if (rafId !== null) {
          window.cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      // Only run while the wall is in view (perf + battery).
      if ('IntersectionObserver' in window) {
        const vio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              onScreen = entry.isIntersecting;
              wall.classList.toggle('is-lit', onScreen);
              if (onScreen) {
                play();
              } else {
                pause();
              }
            });
          },
          { threshold: 0.12 },
        );
        vio.observe(wall);
      } else {
        onScreen = true;
        wall.classList.add('is-lit');
        play();
      }

      // Keep chip geometry correct on resize; cheap debounce.
      let resizeTimer = null;
      window.addEventListener(
        'resize',
        function () {
          if (resizeTimer) window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(function () {
            if (onScreen) measure();
          }, 150);
        },
        { passive: true },
      );

      // Pause when the tab is hidden.
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          pause();
        } else if (onScreen) {
          play();
        }
      });
    }

    /* ---------------------------------------------------------------- *
     * 3. COUNT-UP NUMBERS                                               *
     * Numbers ease to their final value the first time each stat        *
     * scrolls into view. Under reduced motion (or no IO) we skip the    *
     * animation and the server-rendered final value simply stays.       *
     * ---------------------------------------------------------------- */
    const counters = document.querySelectorAll('[data-count]');

    const formatValue = function (el, value) {
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      const prefix = el.getAttribute('data-prefix') || '';
      const suffix = el.getAttribute('data-suffix') || '';
      return prefix + value.toFixed(decimals) + suffix;
    };

    const runCount = function (el) {
      const staticText = el.getAttribute('data-static');
      if (staticText) return; // non-numeric stat, already correct
      const to = parseFloat(el.getAttribute('data-to') || '0');
      if (reduced || !Number.isFinite(to)) {
        el.textContent = formatValue(el, to);
        return;
      }
      const duration = 1500;
      let t0 = null;
      const step = function (ts) {
        if (t0 === null) t0 = ts;
        const p = Math.min((ts - t0) / duration, 1);
        // easeOutExpo — fast then settles, feels precise not springy.
        const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        el.textContent = formatValue(el, to * eased);
        if (p < 1) {
          window.requestAnimationFrame(step);
        } else {
          el.textContent = formatValue(el, to);
        }
      };
      window.requestAnimationFrame(step);
    };

    if (counters.length) {
      if (reduced || !('IntersectionObserver' in window)) {
        counters.forEach(function (el) {
          const staticText = el.getAttribute('data-static');
          if (!staticText) {
            const to = parseFloat(el.getAttribute('data-to') || '0');
            el.textContent = formatValue(el, to);
          }
        });
      } else {
        const cio = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                runCount(entry.target);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        counters.forEach(function (el) {
          cio.observe(el);
        });
      }
    }
  })();
</script>
