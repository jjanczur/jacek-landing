---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PillarGrid from '../../components/PillarGrid.astro';
import LogoWall from '../../components/LogoWall.astro';
import StatStrip from '../../components/StatStrip.astro';
import StepList from '../../components/StepList.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CaseRow from '../../components/CaseRow.astro';
import Button from '../../components/Button.astro';
import DoorPair from '../../components/DoorPair.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const t = await getTranslations('home', lang);

const featuredCases = (await getCollection('case-studies'))
  .filter(c => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  noImageIndex
>
  <Hero {...t.hero} />

  <PillarGrid pillars={t.pillars.items}>
    <SectionHeader
      slot="header"
      eyebrow={t.pillars.eyebrow}
      title={t.pillars.title}
      align="center"
    />
  </PillarGrid>

  <LogoWall
    heading={t.wall.heading}
    lede={t.wall.lede}
    groups={t.wall.groups}
    spotlight
  />

  <StatStrip heading={t.stats.heading} stats={t.stats.items} columns={6} />

  <StepList
    eyebrow={t.method.eyebrow}
    title={t.method.title}
    steps={t.method.steps}
  />

  <section class="section featured" aria-labelledby="featured-heading">
    <div class="container">
      <SectionHeader
        eyebrow={t.featured.eyebrow}
        title={t.featured.title}
        align="center"
        id="featured-heading"
      />
      <ol class="case-rows">
        {
          featuredCases.map((entry, i) => (
            <CaseRow
              index={i}
              href={
                entry.data.hasDetail
                  ? `/${lang}/case-studies/${entry.slug}/`
                  : undefined
              }
              client={entry.data.client}
              skim={entry.data.skim}
              outcome={entry.data.outcomes[0]}
              status={entry.data.status}
              relationship={entry.data.relationship}
              category={entry.data.category}
            />
          ))
        }
      </ol>
      <div class="featured__more reveal">
        <Button href={`/${lang}/case-studies/`} variant="ghost" size="md">
          All case studies
        </Button>
      </div>
    </div>
  </section>

  <DoorPair doors={t.doors} />

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  .featured__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
