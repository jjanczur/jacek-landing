      { note: 'Zertifizierter AI-Anbieter' },
      { note: 'Aktuell' },
      { note: 'Banking' },
      { note: 'Telekommunikation' },
      { note: 'E-Commerce' },
      { note: 'Automotive' },
      { note: 'Analytics' },
      { note: 'Zertifizierung' },
