---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PillarGrid from '../../components/PillarGrid.astro';
import LogoWall from '../../components/LogoWall.astro';
import StatStrip from '../../components/StatStrip.astro';
import StepList from '../../components/StepList.astro';
import DoorPair from '../../components/DoorPair.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const t = await getTranslations('home', lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  noImageIndex
>
  <Hero {...t.hero} />

  <PillarGrid pillars={t.pillars.items} />

  <LogoWall
    heading={t.wall.heading}
    lede={t.wall.lede}
    groups={t.wall.groups}
    spotlight
  />

  <StatStrip heading={t.stats.heading} stats={t.stats.items} columns={6} />

  <StepList
    eyebrow={t.method.eyebrow}
    title={t.method.title}
    steps={t.method.steps}
  />

  <!-- Featured case studies land here once the case-study collection merges (Task 5) -->

  <DoorPair doors={t.doors} />

  <CtaBand {...t.band} />
</BaseLayout>
