---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import DoorPair from '../../components/DoorPair.astro';
import PrincipleList from '../../components/PrincipleList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';
import type { Lang } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getTranslations('consulting', lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Hero {...t.hero} />

  <section class="section-head" data-surface="bare" id="model-section">
    <div class="container">
      <SectionHeader
        title={t.model.title}
        lede={t.model.lede}
        id="model"
        variant="display"
      />
    </div>
  </section>

  <DoorPair doors={t.doors} />

  <section
    class="section section--loose section--divided"
    id="offers-section"
    aria-labelledby="offers"
  >
    <div class="container">
      <SectionHeader
        eyebrow={t.offers.eyebrow}
        title={t.offers.title}
        lede={t.offers.lede}
        id="offers"
      />
      <PrincipleList
        surface="panel"
        columns={2}
        exampleLabel="In practice"
        items={t.offers.items.map(o => ({
          title: o.title,
          body: o.body,
          example: o.proof,
          link: o.href ? { href: o.href, label: 'Read the case' } : undefined,
        }))}
      />
    </div>
  </section>

  <section
    class="section"
    id="fit-section"
    data-surface="bare"
    aria-labelledby="fit"
  >
    <div class="container">
      <SectionHeader title={t.fit.title} id="fit" variant="inline" />
      <div class="fit-grid">
        <div class="fit fit--good surface-bare reveal">
          <h3 class="fit__title">{t.fit.goodTitle}</h3>
          <ul>{t.fit.good.map(item => <li>{item}</li>)}</ul>
        </div>
        <div
          class="fit fit--not surface-bare reveal"
          style="--reveal-delay: var(--stagger)"
        >
          <h3 class="fit__title">{t.fit.notTitle}</h3>
          <ul>{t.fit.not.map(item => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  .section-head {
    padding-block: var(--section-y) 0;
  }
  .fit-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .fit {
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
  }
  .fit__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-lg);
    letter-spacing: var(--tracking-display);
  }
  .fit ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-3);
    color: oklch(from var(--text) l c h / 0.82);
  }
  .fit--good li::marker {
    color: var(--accent);
  }
  .fit--not li::marker {
    color: oklch(from var(--text) l c h / 0.4);
  }
</style>
