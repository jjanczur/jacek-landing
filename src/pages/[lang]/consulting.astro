---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import DoorPair from '../../components/DoorPair.astro';
import PillarGrid from '../../components/PillarGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSupportedLangs, getTranslations } from '../../utils/i18n';
import type { Lang } from '../../utils/i18n';

export function getStaticPaths() {
  return getSupportedLangs().map(lang => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getTranslations('consulting', lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Hero {...t.hero} />

  <section class="section" aria-labelledby="model">
    <div class="container">
      <SectionHeader
        eyebrow={t.model.eyebrow}
        title={t.model.title}
        lede={t.model.lede}
        id="model"
      />
    </div>
  </section>

  <DoorPair doors={t.doors} />

  <section class="section-head">
    <div class="container">
      <SectionHeader
        eyebrow={t.offers.eyebrow}
        title={t.offers.title}
        lede={t.offers.lede}
        id="offers"
      />
    </div>
  </section>
  <PillarGrid pillars={t.offers.items} />

  <section class="section" aria-labelledby="fit">
    <div class="container">
      <SectionHeader eyebrow={t.fit.eyebrow} title={t.fit.title} id="fit" />
      <div class="fit-grid">
        <div class="fit fit--good reveal">
          <h3 class="fit__title">{t.fit.goodTitle}</h3>
          <ul>{t.fit.good.map(item => <li>{item}</li>)}</ul>
        </div>
        <div class="fit fit--not reveal" style="--reveal-delay: 60ms">
          <h3 class="fit__title">{t.fit.notTitle}</h3>
          <ul>{t.fit.not.map(item => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand {...t.band} />
</BaseLayout>

<style>
  .section-head {
    padding-block: var(--section-y) 0;
  }
  .fit-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .fit {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }
  .fit__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-lg);
    letter-spacing: var(--tracking-display);
  }
  .fit ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-3);
    color: oklch(from var(--text) l c h / 0.82);
  }
  .fit--good li::marker {
    color: var(--accent);
  }
  .fit--not li::marker {
    color: oklch(from var(--text) l c h / 0.4);
  }
</style>
