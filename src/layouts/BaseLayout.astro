---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { PUBLISHED_LANGS, isPublished } from '../utils/i18n';
import '../styles/tokens.css';

export interface Props {
  title: string;
  description: string;
  lang: 'en' | 'pl' | 'de';
  ogImage?: string;
  /**
   * Overrides the default robots directives. Pages that show client logos pass
   * `noImageIndex` so the marks stay out of Google/Bing image search — reverse
   * image search is a common candidate source for trademark-monitoring crawlers.
   * Do NOT set it globally: the headshot doubles as the Open Graph image and
   * must remain indexable or social previews break.
   */
  noImageIndex?: boolean;
  /**
   * Extra JSON-LD node merged into the page's `structuredData['@graph']`
   * (e.g. a CreativeWork for a case study). Only emitted on the published
   * document branch below — the redirect shell for unpublished languages
   * never renders structured data.
   */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  lang,
  ogImage,
  noImageIndex = false,
  jsonLd,
} = Astro.props;

const robotsContent = [
  'index, follow',
  ...(noImageIndex ? ['noimageindex'] : []),
  'max-image-preview:large',
  'max-snippet:-1',
  'max-video-preview:-1',
].join(', ');

// Define alternate URLs for hreflang
// Note: `trailingSlash: 'always'` means `Astro.url.pathname` already ends with `/`.
// We normalize to avoid generating `//` in hreflang URLs.
const baseUrl = 'https://janczura.com';
const currentPath = Astro.url.pathname;
const canonicalUrl = `${baseUrl}${currentPath}`;

const supportedLangs = ['en', 'pl', 'de'] as const;
type SupportedLang = (typeof supportedLangs)[number];

const stripTrailingSlashes = (path: string) => path.replace(/\/+$/, '');
const ensureLeadingSlash = (path: string) =>
  path.startsWith('/') ? path : `/${path}`;
const ensureTrailingSlash = (path: string) => `${stripTrailingSlashes(path)}/`;

const getAltPathForLang = (targetLang: SupportedLang) => {
  const normalized = stripTrailingSlashes(currentPath);
  const parts = normalized.split('/').filter(Boolean); // e.g. ["en","projects"]
  const first = parts[0] as string | undefined;
  const rest = supportedLangs.includes(first as SupportedLang)
    ? parts.slice(1)
    : parts;
  const rebuilt = ensureLeadingSlash([targetLang, ...rest].join('/'));
  return ensureTrailingSlash(rebuilt);
};

const alternateUrls: Record<SupportedLang, string> = {
  en: `${baseUrl}${getAltPathForLang('en')}`,
  pl: `${baseUrl}${getAltPathForLang('pl')}`,
  de: `${baseUrl}${getAltPathForLang('de')}`,
};

// Site owner's instruction: only English is published for now. PL/DE routes
// still build (so their URLs resolve) but serve a redirect shell to the
// English equivalent instead of the normal document.
const published = isPublished(lang);
const englishUrl = `${baseUrl}${getAltPathForLang('en')}`;

const cspContent =
  "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; font-src 'self'; connect-src 'self'";

// The published/unpublished branches below live inside a single JS
// expression (a ternary), so these inline scripts are passed via set:html
// rather than as literal <script> children — Astro/JSX expression regions
// don't parse embedded <script> block statements the same way top-level
// template content does.
const themeInitScript = `
  // Simple theme initialization - read from localStorage
  try {
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.dataset.theme = savedTheme;
  } catch {
    // localStorage not available, use default light theme
    document.documentElement.dataset.theme = 'light';
  }
`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://janczura.com/#person',
      name: 'Jacek Janczura',
      alternateName: 'Jacek Janczura',
      jobTitle:
        'Co-founder & CTO of Jaden Data (2021–2024) · Fractional CTO & consulting partner',
      description:
        'Founder-CTO working on enterprise AI. Co-founded Jaden Data and led it as CTO to €1M+ annual revenue and a ten-person engineering team; fractional CTO and consulting partner since 2024. Production AI for regulated enterprises including APG, a €500B+ pension fund; distributed systems for Norges Bank and ING; ISO 27001 and SOC 2.',
      url: 'https://janczura.com',
      image: 'https://janczura.com/images/headshot.jpg',
      sameAs: [
        'https://linkedin.com/in/jacekjanczura',
        'https://github.com/jjanczur',
        'https://www.researchgate.net/profile/Jacek_Janczura',
      ],
      knowsAbout: [
        'Artificial Intelligence',
        'Machine Learning',
        'LLM Platforms',
        'Retrieval-Augmented Generation',
        'RAG Systems',
        'Vector Databases',
        'Graph Databases',
        'Enterprise Chatbots',
        'Fractional CTO',
        'Cloud Architecture',
        'AWS',
        'Azure',
        'Distributed Systems',
        'Microservices',
        'Cybersecurity',
        'ISO 27001',
        'SOC 2',
        'Process Intelligence',
        'Enterprise AI',
        'AI Native Systems',
        'Event-Driven Architecture',
        'Serverless Computing',
        'Technology Leadership',
        'Technical Pre-sales',
        'Team Building',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Founder-CTO & Enterprise AI Leader',
        skills: [
          'Enterprise LLM Platforms',
          'RAG Systems',
          'Cloud Architecture',
          'Security & Compliance',
          'Technical Leadership',
        ],
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Jaden Data',
        url: 'https://jaden-data.com',
      },
      alumniOf: [
        {
          '@type': 'EducationalOrganization',
          name: 'Technische Universität Berlin',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'Warsaw University of Technology',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://janczura.com/#website',
      url: 'https://janczura.com',
      name: 'Jacek Janczura',
      inLanguage: ['en', 'pl', 'de'],
      publisher: { '@id': 'https://janczura.com/#person' },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': 'https://janczura.com/#website' },
      about: { '@id': 'https://janczura.com/#person' },
    },
    ...(jsonLd ? [jsonLd] : []),
  ],
};
---

{
  published ? (
    <html lang={lang} data-theme="light">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        {/* Resource hints - Must be early to establish connections before other resources */}
        {/* Preconnect to same origin for faster asset loading (though CSS will be inlined) */}
        <link rel="preconnect" href={baseUrl} />
        <link rel="dns-prefetch" href={baseUrl} />
        {/* Self-hosted fonts: preload primary (latin) variable weights, same-origin */}
        <link
          rel="preload"
          href="/fonts/dm-sans-latin-wght-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/fonts/rubik-latin-wght-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Jacek Janczura" />
        <meta
          name="keywords"
          content="Jacek Janczura, Founder-CTO, CTO, Head of AI, Enterprise AI, Technology leadership, LLM Platforms, RAG Systems, Cloud Architecture, ISO 27001, SOC 2, Fractional CTO, Interim CTO"
        />
        <meta name="robots" content={robotsContent} />
        <link rel="canonical" href={canonicalUrl} />

        {/* Open Graph */}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
          property="og:image"
          content={ogImage || `${baseUrl}/images/headshot.jpg`}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="Jacek Janczura" />
        <meta
          property="og:locale"
          content={lang === 'en' ? 'en_US' : lang === 'pl' ? 'pl_PL' : 'de_DE'}
        />

        {/* Twitter Card */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
          name="twitter:image"
          content={ogImage || `${baseUrl}/images/headshot.jpg`}
        />
        <meta name="twitter:creator" content="@jacekjanczura" />
        <meta name="twitter:site" content="@jacekjanczura" />

        {/* Hreflang alternates: only published languages, plus x-default (English) */}
        {PUBLISHED_LANGS.map(publishedLang => (
          <link
            rel="alternate"
            hreflang={publishedLang}
            href={alternateUrls[publishedLang]}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />

        {/* Fonts are self-hosted (see @font-face in src/styles/tokens.css):
      DM Sans (body) + Rubik (headings). No third-party font requests. */}

        {/* JSON-LD Structured Data */}
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />

        {/* CSP Meta Tag (for GitHub Pages - HTTP headers in _headers file for Netlify/Cloudflare)
      Using 'unsafe-inline' for script-src to allow inline scripts on this frontend-only landing page
      style-src keeps 'unsafe-inline' because Astro inlines stylesheets
      Note: frame-ancestors is only valid in HTTP headers, not meta tags */}
        <meta http-equiv="Content-Security-Policy" content={cspContent} />

        {/* Theme initialization — must run before paint, so it stays inline. */}
        <script is:inline set:html={themeInitScript} />
        <slot name="head" />
      </head>
      <body>
        <NavBar lang={lang} />
        <main style="min-height: calc(100vh - 64px - 120px);">
          <slot />
        </main>
        <Footer lang={lang} />
      </body>
    </html>
  ) : (
    <html lang={lang}>
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="canonical" href={englishUrl} />
        <meta http-equiv="refresh" content={`0; url=${englishUrl}`} />
        <meta http-equiv="Content-Security-Policy" content={cspContent} />
        <script define:vars={{ englishUrl }}>
          window.location.replace(englishUrl);
        </script>
      </head>
      <body>
        <p>
          This page is published in English.{' '}
          <a href={englishUrl}>Continue to the English page</a>
        </p>
      </body>
    </html>
  )
}

<script>
  // Scroll reveal: arm the hidden state synchronously, then reveal on entry.
  // Skipped entirely under reduced motion or without IO support, which leaves
  // every .reveal element visible. No blanket timer.
  try {
    if (
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      'IntersectionObserver' in window
    ) {
      document.documentElement.classList.add('reveal-on');
      const setup = () => {
        const io = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setup);
      } else {
        setup();
      }
    }
  } catch {
    /* reveal is a progressive enhancement; ignore failures */
  }
</script>

<script>
  if ('serviceWorker' in navigator) {
    const registerSW = () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* caching is best-effort */
      });
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(registerSW, { timeout: 2000 });
    } else {
      window.setTimeout(registerSW, 2000);
    }
  }
</script>
