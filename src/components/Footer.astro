---
export interface Props {
  lang: 'en' | 'pl' | 'de';
}

const { lang } = Astro.props;

const footerNav = {
  en: {
    site: {
      title: 'Site',
      links: [
        { href: '/en/case-studies/', label: 'Case studies' },
        { href: '/en/leadership/', label: 'Leadership' },
        { href: '/en/consulting/', label: 'Consulting' },
        { href: '/en/about/', label: 'About' },
        { href: '/en/contact/', label: 'Contact' },
      ],
    },
    work: {
      title: 'Work',
      links: [
        { href: '/en/turnaround/', label: 'Tech turnaround' },
        { href: '/en/builder/', label: 'AI systems architecture' },
        { href: '/en/writing/', label: 'Writing & Talks' },
        { href: '/tools/', label: 'Tools' },
      ],
    },
    legal: {
      title: 'Legal',
      links: [
        { href: '/en/privacy/', label: 'Privacy Policy' },
        { href: '/en/imprint/', label: 'Imprint' },
      ],
    },
  },
  pl: {
    site: {
      title: 'Site',
      links: [
        { href: '/pl/case-studies/', label: 'Case studies' },
        { href: '/pl/leadership/', label: 'Leadership' },
        { href: '/pl/consulting/', label: 'Konsulting' },
        { href: '/pl/about/', label: 'O mnie' },
        { href: '/pl/contact/', label: 'Kontakt' },
      ],
    },
    work: {
      title: 'Work',
      links: [
        { href: '/pl/turnaround/', label: 'Modernizacja i turnaround' },
        { href: '/pl/builder/', label: 'Architektura systemów AI' },
        { href: '/pl/writing/', label: 'Pisanie i Wystąpienia' },
        { href: '/tools/', label: 'Narzędzia' },
      ],
    },
    legal: {
      title: 'Legal',
      links: [
        { href: '/pl/privacy/', label: 'Polityka Prywatności' },
        { href: '/pl/imprint/', label: 'Informacje Prawne' },
      ],
    },
  },
  de: {
    site: {
      title: 'Site',
      links: [
        { href: '/de/case-studies/', label: 'Case studies' },
        { href: '/de/leadership/', label: 'Leadership' },
        { href: '/de/consulting/', label: 'Beratung' },
        { href: '/de/about/', label: 'Über mich' },
        { href: '/de/contact/', label: 'Kontakt' },
      ],
    },
    work: {
      title: 'Work',
      links: [
        { href: '/de/turnaround/', label: 'Tech-Turnaround' },
        { href: '/de/builder/', label: 'AI-Systemarchitektur' },
        { href: '/de/writing/', label: 'Schreiben & Vorträge' },
        { href: '/tools/', label: 'Tools' },
      ],
    },
    legal: {
      title: 'Legal',
      links: [
        { href: '/de/privacy/', label: 'Datenschutzerklärung' },
        { href: '/de/imprint/', label: 'Impressum' },
      ],
    },
  },
} as const;

const f = footerNav[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-groups">
      {
        [f.site, f.work, f.legal].map(group => (
          <nav
            class={`footer-group footer-group--${group === f.site ? 'site' : group === f.work ? 'work' : 'legal'}`}
            aria-label={group.title}
          >
            <h2 class="footer-group__title">{group.title}</h2>
            <ul>
              {group.links.map(l => (
                <li>
                  <a href={l.href} class="footer-nav-link">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="footer-attribution">
      Logos are the property of their respective owners and mark organisations
      Jacek has delivered work for; no endorsement is implied.
    </p>

    <div class="footer-bottom">
      <p class="copyright">© {year} Jacek Janczura</p>
      <div class="social-links">
        <a
          href="https://linkedin.com/in/jacekjanczura"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="LinkedIn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </a>
        <a
          href="https://github.com/jjanczur"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="GitHub"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .footer-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .footer-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-group__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(from var(--text) l c h / 0.6);
  }

  .footer-nav-link {
    color: var(--text);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-normal);
    transition: color 0.2s;
  }

  .footer-nav-link:hover {
    color: var(--primary);
  }

  /* D21: exactly one attribution sentence on the whole site, and it lives here. */
  .footer-attribution {
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    max-width: 70ch;
    font-size: var(--font-size-xs);
    color: oklch(from var(--text) l c h / 0.55);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .copyright {
    color: var(--text);
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
  }

  .social-link {
    color: var(--text);
    transition: color 0.2s;
  }

  .social-link:hover {
    color: var(--primary);
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      text-align: center;
    }
  }
</style>
