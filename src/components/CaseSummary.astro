---
import OutcomeBadge from './OutcomeBadge.astro';

interface Outcome {
  value: string;
  label: string;
  evidence:
    | 'measured'
    | 'customer-estimate'
    | 'projected'
    | 'qualitative'
    | 'benchmark';
  countTo?: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
}

export interface Props {
  mandate: string;
  keyDecisions: string[];
  outcomes: Outcome[];
  status?: string;
  relationship: string;
  via?: string;
}

const { mandate, keyDecisions, outcomes, status, relationship, via } =
  Astro.props;

const RELATIONSHIP_LABEL: Record<string, string> = {
  client: 'Client engagement',
  independent: 'Independent engagement',
  employer: 'Employment',
  'own-company': 'Own company',
  'research-partner': 'Research partnership',
};

const STATUS_LABEL: Record<string, string> = {
  production: 'Production',
  mvp: 'MVP',
  poc: 'Proof of concept',
  prototype: 'Prototype',
  research: 'Research',
};

// CS-7: the evidence class is named once in the outcome heading rather than
// shouted from every badge — the dominant kind drops its pill.
const counts = outcomes.reduce<Record<string, number>>((acc, o) => {
  acc[o.evidence] = (acc[o.evidence] ?? 0) + 1;
  return acc;
}, {});
const dominant = Object.entries(counts).sort((a, b) => b[1] - a[1])[0]?.[0];
const DOMINANT_SUFFIX: Record<string, string> = {
  measured: ' — measured',
  'customer-estimate': ' — customer estimates',
  projected: ' — projected',
  qualitative: ' — qualitative',
  benchmark: ' — technical benchmarks',
};
// Built ahead of the template (rather than inline in the JSX) so no
// whitespace text node sneaks between the tag and the expression.
const outcomeHeading = `Outcome${DOMINANT_SUFFIX[dominant ?? ''] ?? ''}`;
---

<div class="case-summary reveal surface-raised">
  <p class="case-summary__meta">
    {RELATIONSHIP_LABEL[relationship] ?? relationship}{via && ` · via ${via}`}
    {
      status && (
        <span class="case-summary__status">
          {STATUS_LABEL[status] ?? status}
        </span>
      )
    }
  </p>
  <div class="case-summary__grid">
    <div class="case-summary__col">
      <h3 class="case-summary__heading">Mandate</h3>
      <p class="case-summary__mandate">{mandate}</p>
    </div>
    <div class="case-summary__col">
      <h3 class="case-summary__heading">Key decisions</h3>
      <ol class="case-summary__decisions">
        {
          keyDecisions.map(decision => (
            <li class="case-summary__decision">{decision}</li>
          ))
        }
      </ol>
    </div>
    <div class="case-summary__col case-summary__col--outcomes">
      <h3 class="case-summary__heading">{outcomeHeading}</h3>
      <div class="case-summary__outcomes">
        {
          outcomes.map(outcome => (
            <OutcomeBadge
              value={outcome.value}
              label={outcome.label}
              evidence={outcome.evidence}
              countTo={outcome.countTo}
              prefix={outcome.prefix}
              suffix={outcome.suffix}
              decimals={outcome.decimals}
              showEvidence={outcome.evidence !== dominant}
            />
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .case-summary {
    margin-bottom: var(--space-8);
  }

  .case-summary__meta {
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: oklch(from var(--text) l c h / 0.7);
  }

  .case-summary__status {
    padding: 0.2em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--font-size-xs);
    color: var(--text);
  }

  .case-summary__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7);
  }

  .case-summary__heading {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--font-size-base);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .case-summary__mandate {
    margin: 0;
    color: oklch(from var(--text) l c h / 0.88);
  }

  .case-summary__decisions {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-summary__decision {
    color: oklch(from var(--text) l c h / 0.88);
  }

  .case-summary__outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .case-summary__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
