---
import Button from './Button.astro';
import AvailabilityPill from './AvailabilityPill.astro';
export interface Props {
  eyebrow: string;
  title: string;
  sub: string;
  primary: { href: string; label: string };
  ghost?: { href: string; label: string; external?: boolean };
  availability?: string;
  align?: 'left' | 'center';
}
const {
  eyebrow,
  title,
  sub,
  primary,
  ghost,
  availability,
  align = 'left',
} = Astro.props;
---

<section class={`hero hero--${align}`}>
  <div class="aurora" aria-hidden="true">
    <span class="aurora__blob aurora__blob--a"></span>
    <span class="aurora__blob aurora__blob--b"></span>
    <span class="aurora__blob aurora__blob--c"></span>
    <span class="aurora__grid"></span>
  </div>
  <div class="container hero__inner">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1
      class="hero__title reveal"
      style="--reveal-delay: 60ms"
      set:html={title}
    />
    <p class="hero__sub reveal" style="--reveal-delay: 140ms" set:html={sub} />
    <div class="hero__cta reveal" style="--reveal-delay: 220ms">
      <Button href={primary.href} variant="primary" size="lg"
        >{primary.label}</Button
      >
      {
        ghost && (
          <Button
            href={ghost.href}
            variant="ghost"
            size="lg"
            external={ghost.external}
          >
            {ghost.label}
          </Button>
        )
      }
    </div>
    {
      availability && (
        <div class="reveal" style="--reveal-delay: 300ms">
          <AvailabilityPill text={availability} />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--section-y) * 1.1) var(--section-y);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--w-hero);
  }

  .hero--center .hero__inner {
    margin-inline: auto;
    text-align: center;
  }
  .hero--center .hero__cta {
    justify-content: center;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--font-size-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }
  .hero__title :global(em) {
    font-style: normal;
    color: var(--primary);
  }

  .hero__sub {
    font-size: var(--font-size-lg);
    max-width: var(--w-prose);
    color: oklch(from var(--text) l c h / 0.82);
    margin-bottom: var(--space-6);
  }
  .hero--center .hero__sub {
    margin-inline: auto;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  /* ------------------------------------------------------------------ *
   * AURORA BACKGROUND — ported from turnaround.astro                    *
   * ------------------------------------------------------------------ */
  .aurora {
    position: absolute;
    inset: -20% -10% 0;
    z-index: 0;
    pointer-events: none;
    filter: blur(2px);
  }

  .aurora__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
    will-change: transform;
  }

  .aurora__blob--a {
    top: -8%;
    left: 4%;
    width: 46vw;
    height: 46vw;
    max-width: 620px;
    max-height: 620px;
    background: radial-gradient(
      circle at 30% 30%,
      color-mix(in oklab, var(--primary) 55%, transparent),
      transparent 68%
    );
    animation: drift-a 22s var(--ease-in-out) infinite alternate;
  }

  .aurora__blob--b {
    top: 6%;
    right: 2%;
    width: 40vw;
    height: 40vw;
    max-width: 540px;
    max-height: 540px;
    background: radial-gradient(
      circle at 60% 40%,
      color-mix(in oklab, var(--accent) 60%, transparent),
      transparent 66%
    );
    animation: drift-b 26s var(--ease-in-out) infinite alternate;
  }

  .aurora__blob--c {
    bottom: -18%;
    left: 32%;
    width: 38vw;
    height: 38vw;
    max-width: 500px;
    max-height: 500px;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--highlight) 42%, transparent),
      transparent 70%
    );
    animation: drift-c 30s var(--ease-in-out) infinite alternate;
  }

  .aurora__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--border) 55%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--border) 55%, transparent) 1px,
        transparent 1px
      );
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 60% at 50% 30%,
      #000 0%,
      transparent 75%
    );
    mask-image: radial-gradient(
      ellipse 70% 60% at 50% 30%,
      #000 0%,
      transparent 75%
    );
    opacity: 0.5;
  }

  @keyframes drift-a {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(4%, 6%, 0) scale(1.12);
    }
  }
  @keyframes drift-b {
    from {
      transform: translate3d(0, 0, 0) scale(1.05);
    }
    to {
      transform: translate3d(-5%, 4%, 0) scale(0.95);
    }
  }
  @keyframes drift-c {
    from {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    to {
      transform: translate3d(3%, -5%, 0) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora__blob {
      animation: none;
    }
  }
</style>
