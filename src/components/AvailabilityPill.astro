---
export interface Props {
  text: string;
  ariaLabel?: string;
}
const { text, ariaLabel = 'Availability' } = Astro.props;
---

<p class="availability" aria-label={ariaLabel}>
  <span class="availability__dot" aria-hidden="true"></span>{text}
</p>

<style>
  .availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-1);
    font-size: var(--font-size-sm);
    color: var(--text);
  }
  .availability__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 oklch(from var(--accent) l c h / 0.5);
    animation: availability-pulse 2.4s ease-out infinite;
  }
  @keyframes availability-pulse {
    0% {
      box-shadow: 0 0 0 0 oklch(from var(--accent) l c h / 0.5);
    }
    70% {
      box-shadow: 0 0 0 10px oklch(from var(--accent) l c h / 0);
    }
    100% {
      box-shadow: 0 0 0 0 oklch(from var(--accent) l c h / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .availability__dot {
      animation: none;
    }
  }
</style>
