---
export interface Props {
  text: string;
  ariaLabel?: string;
}
const { text, ariaLabel = 'Availability' } = Astro.props;
---

<p class="availability" aria-label={ariaLabel}>
  <span class="availability__dot" aria-hidden="true"></span>{text}
</p>

<style>
  .availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-1);
    font-size: var(--font-size-sm);
    color: var(--text);
  }
  /* Availability is a fact, not an event: a static 6px dot, no infinite
     ring (AI-6). The pill keeps its round ends — it is a status chip, not
     a button. */
  .availability__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
