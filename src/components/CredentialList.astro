---
export interface CredentialItem {
  title: string;
  meta?: string;
  note?: string;
}
export interface CredentialGroup {
  title: string;
  items: CredentialItem[];
}
export interface Props {
  groups: CredentialGroup[];
}
const { groups } = Astro.props;
---

<div class="credentials">
  {
    groups.map((group, i) => (
      <section
        class="credentials__group reveal"
        style={`--reveal-delay: ${i * 60}ms`}
      >
        <h3 class="credentials__group-title">{group.title}</h3>
        <ul class="credentials__list" role="list">
          {group.items.map(item => (
            <li class="credentials__item">
              <p class="credentials__item-title">{item.title}</p>
              {item.meta && <p class="credentials__meta">{item.meta}</p>}
              {item.note && <p class="credentials__note">{item.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .credentials {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 900px) {
    .credentials {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
  .credentials__group-title {
    font-size: var(--font-size-lg);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .credentials__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .credentials__item-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .credentials__meta {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--primary);
  }
  .credentials__note {
    margin: 0;
    font-size: var(--font-size-sm);
    color: oklch(from var(--text) l c h / 0.72);
  }
</style>
