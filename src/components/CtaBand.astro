---
import Button from './Button.astro';
import AvailabilityPill from './AvailabilityPill.astro';
export interface Props {
  title: string;
  sub?: string;
  primary: { href: string; label: string; external?: boolean };
  secondary?: { href: string; label: string; external?: boolean };
  note?: string;
}
const { title, sub, primary, secondary, note } = Astro.props;
---

<section class="cta-band section">
  <div class="container">
    <div class="cta-band__card reveal">
      <h2 class="cta-band__title">{title}</h2>
      {sub && <p class="cta-band__sub">{sub}</p>}
      <div class="cta-band__actions">
        <Button
          href={primary.href}
          variant="primary"
          size="lg"
          external={primary.external}>{primary.label}</Button
        >
        {
          secondary && (
            <Button
              href={secondary.href}
              variant="ghost"
              size="lg"
              external={secondary.external}
            >
              {secondary.label}
            </Button>
          )
        }
      </div>
      {note && <AvailabilityPill text={note} />}
    </div>
  </div>
</section>

<style>
  .cta-band__card {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-1), var(--bg));
  }

  .cta-band__title {
    font-size: var(--font-size-h2);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--space-4);
  }

  .cta-band__sub {
    max-width: var(--w-prose);
    margin-inline: auto;
    margin-bottom: var(--space-6);
    font-size: var(--font-size-lg);
    color: oklch(from var(--text) l c h / 0.78);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
</style>
