---
export interface TimelineItem {
  period: string;
  title: string;
  org: string;
  outcome: string;
  contribution: string;
  href?: string;
}
export interface Props {
  items: TimelineItem[];
}
const { items } = Astro.props;
const isPdf = (href: string) => href.toLowerCase().endsWith('.pdf');
---

<ol class="timeline" role="list">
  {
    items.map((item, i) => (
      <li class="timeline__item reveal" style={`--reveal-delay: ${i * 60}ms`}>
        <p class="timeline__period">{item.period}</p>
        <div class="timeline__body">
          <h3 class="timeline__title">{item.title}</h3>
          <p class="timeline__org">{item.org}</p>
          <p class="timeline__line">
            <span class="timeline__label">Outcome</span>
            {item.outcome}
          </p>
          <p class="timeline__line">
            <span class="timeline__label">Contribution</span>
            {item.contribution}
          </p>
          {item.href && (
            <p class="timeline__link">
              <a
                href={item.href}
                target={isPdf(item.href) ? '_blank' : undefined}
                rel={isPdf(item.href) ? 'noopener noreferrer' : undefined}
              >
                {isPdf(item.href) ? 'Reference (PDF)' : 'See the case'}
              </a>
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .timeline__item {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .timeline__item {
      grid-template-columns: 12rem 1fr;
      gap: var(--space-6);
    }
  }
  .timeline__period {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .timeline__body {
    max-width: var(--w-prose);
  }
  .timeline__title {
    font-size: var(--font-size-xl);
    margin: 0 0 var(--space-1);
  }
  .timeline__org {
    margin: 0 0 var(--space-4);
    color: oklch(from var(--text) l c h / 0.66);
  }
  .timeline__line {
    margin: 0 0 var(--space-3);
    color: oklch(from var(--text) l c h / 0.82);
  }
  .timeline__label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(from var(--text) l c h / 0.55);
  }
  .timeline__link {
    margin: 0;
    font-size: var(--font-size-sm);
  }
</style>
