---
export interface Props {
  value: string;
  label: string;
  evidence:
    | 'measured'
    | 'customer-estimate'
    | 'projected'
    | 'qualitative'
    | 'benchmark';
  countTo?: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  showEvidence?: boolean;
}
const {
  value,
  label,
  evidence,
  countTo,
  prefix,
  suffix,
  decimals,
  showEvidence = true,
} = Astro.props;

const EVIDENCE_LABEL: Record<Props['evidence'], string> = {
  measured: 'Measured',
  'customer-estimate': 'Customer estimate',
  projected: 'Projected',
  qualitative: 'Qualitative',
  benchmark: 'Technical benchmark',
};
---

<div class="outcome" data-evidence={evidence}>
  <span
    class="outcome__value"
    data-count={countTo !== undefined ? '' : undefined}
    data-to={countTo}
    data-prefix={prefix || ''}
    data-suffix={suffix || ''}
    data-decimals={decimals ?? 0}>{value}</span
  >
  <span class="outcome__label">{label}</span>
  {
    showEvidence && (
      <span class="outcome__evidence">{EVIDENCE_LABEL[evidence]}</span>
    )
  }
</div>

<style>
  .outcome {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  .outcome__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-xl);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .outcome__label {
    font-size: var(--font-size-sm);
    color: oklch(from var(--text) l c h / 0.75);
  }

  .outcome__evidence {
    align-self: flex-start;
    margin-top: 0.2em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* Evidence pill colour by kind: measured = accent, benchmark = primary,
     everything else (customer-estimate, projected, qualitative) = neutral line. */
  .outcome[data-evidence='measured'] .outcome__evidence {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--text);
  }
  .outcome[data-evidence='benchmark'] .outcome__evidence {
    background: var(--primary-soft);
    border-color: transparent;
    color: var(--primary);
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const card = document.querySelector('.case-summary');
  const values = card?.querySelectorAll('.outcome__value[data-count][data-to]');
  if (
    card &&
    values &&
    values.length &&
    !reduced &&
    'IntersectionObserver' in window
  ) {
    const fmt = (el: Element, v: number) =>
      (el.getAttribute('data-prefix') || '') +
      v.toFixed(parseInt(el.getAttribute('data-decimals') || '0', 10)) +
      (el.getAttribute('data-suffix') || '');
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.disconnect();
          values.forEach(el => {
            const to = parseFloat(el.getAttribute('data-to') || '0');
            if (!Number.isFinite(to)) return;
            let t0: number | null = null;
            const step = (ts: number) => {
              if (t0 === null) t0 = ts;
              const p = Math.min((ts - t0) / 900, 1);
              el.textContent = fmt(
                el,
                to * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)),
              );
              if (p < 1) window.requestAnimationFrame(step);
              else el.textContent = fmt(el, to);
            };
            window.requestAnimationFrame(step);
          });
        }
      },
      { threshold: 0.4 },
    );
    io.observe(card);
  }
</script>
