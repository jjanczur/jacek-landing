# Local-only: maps the UUID logo filenames back to the companies they belong to.
# Deliberately NOT committed — this repository is public.
/logo-map.local.json

# Private working docs: canonical copies live in the private cv-magician repo.
/docs/knowledge-base.md
/docs/superpowers/

# Parallel task worktrees
/.worktrees/

# Company-named logo source files. Never committed: the site serves only the
# UUID-named WebP copies under public/media/ (see the logo-hygiene rule).
/src/assets/images/logos/

# Agent working directory (plans, ledgers, review packages, screenshots).
# Tracked here rather than in an untracked nested .gitignore, which fresh
# git worktrees never receive.
/.superpowers/
