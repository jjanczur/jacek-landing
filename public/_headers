# Security headers - applied to all pages
# This file is used by Cloudflare Pages and Netlify
# For GitHub Pages, use the service worker (sw.js) instead
# Content Security Policy: Removed 'unsafe-inline' from script-src, using SHA256 hashes instead
# style-src keeps 'unsafe-inline' because Astro inlines stylesheets (inlineStylesheets: 'always')
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=3600, must-revalidate

# Cache headers for static assets
# Images - cache for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Client logos. Filenames are UUIDs, so they are safe to cache forever.
# X-Robots-Tag keeps the marks out of image search; note it does NOTHING on
# GitHub Pages (which ignores this file entirely) — the page-level
# `noimageindex` in BaseLayout.astro is what actually applies today. This block
# exists so the behaviour is correct if the site ever moves to Cloudflare Pages.
/media/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, noimageindex

# CSS and JS from Astro build - cache for 1 year
# Note: assets directory is configured in astro.config.mjs
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - cache for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Favicon - cache for 1 year
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
